[Unit]
Description=Office Door Sign Web App
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
Environment=OFFICE_SIGN_CONFIG=__INSTALL_DIR__/config.json
Environment=OFFICE_SIGN_STATE=__INSTALL_DIR__/state.json
ExecStart=__INSTALL_DIR__/.venv/bin/gunicorn --workers 1 --bind 0.0.0.0:8080 app.app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
